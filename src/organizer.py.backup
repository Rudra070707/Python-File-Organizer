# ============================================================================
# CATEGORY ORDER
# ============================================================================

# Kept separate from FILE_CATEGORIES because GUI presentation order may
# differ from the internal category mapping.
CATEGORY_ORDER: list[str] = [
    "Images",
    "Documents",
    "Videos",
    "Music",
    "Archives",
    "Programs",
    "Others",
]


# ============================================================================
# SPECIAL COMPOUND EXTENSIONS
# ============================================================================

# Compound extensions must be checked before Path.suffix.
#
# Example:
#     example.tar.gz
#
# Path.suffix returns ".gz", but the complete archive extension is ".tar.gz".
COMPOUND_EXTENSIONS: frozenset[str] = frozenset(
    {
        ".tar.gz",
        ".tar.bz2",
        ".tar.xz",
        ".tar.zst",
        ".tar.lz",
        ".tar.lzma",
    }
)


# A deterministic order is preferable to iterating directly over a
# frozenset. This does not change classification; it only makes the
# implementation predictable.
_COMPOUND_EXTENSIONS_SORTED: tuple[str, ...] = tuple(
    sorted(
        COMPOUND_EXTENSIONS,
        key=len,
        reverse=True,
    )
)


# ============================================================================
# PRECOMPUTED EXTENSION LOOKUP
# ============================================================================

EXTENSION_TO_CATEGORY: dict[str, str] = {
    extension.casefold(): category
    for category, extensions in FILE_CATEGORIES.items()
    for extension in extensions
}


# ============================================================================
# INTERNAL HELPERS
# ============================================================================


def _normalize_path(path: PathLike) -> Path:
    """
    Convert a path-like value into a Path object.

    The path is deliberately not resolved.

    Resolving a path can:
        - access the filesystem,
        - follow symbolic links,
        - alter the representation expected by callers/tests.

    Returns:
        Path: Normalized Path object.
    """
    if isinstance(path, Path):
        return path

    return Path(path)


def _is_safe_regular_file(path: Path) -> bool:
    """
    Return True only for an accessible regular file that is not a symlink.

    Symbolic links are intentionally rejected because following a symbolic
    link could cause the organizer to operate on a file outside the selected
    directory.
    """
    try:
        if path.is_symlink():
            return False

        return path.is_file()

    except OSError:
        return False


def _path_exists(path: Path) -> bool:
    """
    Safely determine whether a filesystem entry exists.

    Broken symbolic links are treated as existing entries because
    ``Path.exists()`` alone returns False for broken links.

    This distinction is important when deciding whether it is safe to use
    a destination filename.
    """
    try:
        return path.exists() or path.is_symlink()

    except OSError:
        return False


def _is_safe_destination_file(path: Path) -> bool:
    """
    Return True when ``path`` is a regular, non-symbolic-link file.

    Used when undoing operations so that a symbolic link is never treated
    as an organizer-created file.
    """
    try:
        if path.is_symlink():
            return False

        return path.is_file()

    except OSError:
        return False


def _safe_category_directory(folder: Path, category: str) -> Path:
    """
    Return a safe category directory, creating it when necessary.

    Category names originate from the internal CATEGORY_ORDER /
    FILE_CATEGORIES definitions rather than arbitrary user input.

    A symbolic-link category directory is always rejected.

    Raises:
        PermissionError:
            If the directory cannot be accessed or created.

        NotADirectoryError:
            If the category path exists but is not a directory.

        OSError:
            For other filesystem failures.
    """
    destination = folder / category

    # ------------------------------------------------------------------------
    # Check the path itself before creating/accessing it.
    # ------------------------------------------------------------------------

    try:
        if destination.is_symlink():
            raise OSError(
                f"Refusing to use symbolic-link category directory: {destination}"
            )

        if destination.exists() and not destination.is_dir():
            raise NotADirectoryError(
                f"Category path is not a directory: {destination}"
            )

    except PermissionError as error:
        raise PermissionError(
            f"Permission denied while accessing category directory: {destination}"
        ) from error

    except OSError:
        # Preserve the original exception type.
        raise

    # ------------------------------------------------------------------------
    # Create the directory if necessary.
    # ------------------------------------------------------------------------

    try:
        destination.mkdir(
            parents=True,
            exist_ok=True,
        )

    except PermissionError as error:
        raise PermissionError(
            f"Permission denied while creating category directory: {destination}"
        ) from error

    except OSError:
        # Preserve filesystem-specific exceptions such as
        # FileExistsError / NotADirectoryError.
        raise

    # ------------------------------------------------------------------------
    # Re-check after mkdir to guard against filesystem races.
    # ------------------------------------------------------------------------

    try:
        if destination.is_symlink():
            raise OSError(
                f"Refusing to use symbolic-link category directory: {destination}"
            )

        if not destination.is_dir():
            raise NotADirectoryError(
                f"Category path is not a directory: {destination}"
            )

    except PermissionError as error:
        raise PermissionError(
            f"Permission denied while accessing category directory: {destination}"
        ) from error

    except OSError:
        # Preserve the original exception type.
        raise

    return destination


def _split_filename(filename: str) -> tuple[str, str]:
    """
    Split a filename into stem and suffix while preserving compound
    extensions.

    Examples:
        photo.jpg       -> ("photo", ".jpg")
        archive.tar.gz  -> ("archive", ".tar.gz")
        README          -> ("README", "")
        backup.tar.bz2  -> ("backup", ".tar.bz2")

    This produces cleaner collision names such as:

        archive.tar.gz
        archive_1.tar.gz

    instead of:

        archive.tar_1.gz
    """
    lowered = filename.casefold()

    for extension in _COMPOUND_EXTENSIONS_SORTED:
        if lowered.endswith(extension):
            return (
                filename[: -len(extension)],
                filename[-len(extension) :],
            )

    path = Path(filename)

    return (
        path.stem,
        path.suffix,
    )


def _record_paths(
    item: Mapping[str, object],
) -> tuple[Path, Path] | None:
    """
    Safely extract source and destination paths from an operation record.

    Returns:
        tuple[Path, Path] | None:
            ``(source, destination)`` when the record is valid.
            ``None`` when required fields are missing or invalid.
    """
    try:
        source_value = item["source"]
        destination_value = item["destination"]

        if not isinstance(source_value, (str, Path)):
            return None

        if not isinstance(destination_value, (str, Path)):
            return None

        return (
            _normalize_path(source_value),
            _normalize_path(destination_value),
        )

    except (KeyError, TypeError, ValueError):
        return None


# ============================================================================
# CATEGORY DETECTION
# ============================================================================


def get_category(file_path: PathLike) -> str:
    """
    Return the category for a file based on its extension.

    Matching is case-insensitive.

    Compound extensions are checked before normal extensions.

    Unknown extensions are classified as ``Others``.

    Examples:
        photo.JPG       -> Images
        report.PDF      -> Documents
        archive.tar.gz  -> Archives
        unknown.xyz     -> Others
    """
    path = _normalize_path(file_path)

    filename = path.name.casefold()

    # Compound extensions must be checked first.
    for extension in _COMPOUND_EXTENSIONS_SORTED:
        if filename.endswith(extension):
            return "Archives"

    # Normal extension lookup.
    extension = path.suffix.casefold()

    return EXTENSION_TO_CATEGORY.get(
        extension,
        "Others",
    )


# ============================================================================
# FOLDER VALIDATION
# ============================================================================


def _validate_folder(folder: PathLike) -> Path:
    """
    Validate a folder path without resolving it.

    Validation includes:
        - existence,
        - directory type,
        - ability to inspect directory contents.

    Raises:
        FileNotFoundError:
            The folder does not exist.

        NotADirectoryError:
            The supplied path is not a directory.

        PermissionError:
            The directory cannot be accessed.

        OSError:
            The filesystem cannot inspect the directory.
    """
    folder = _normalize_path(folder)

    # ------------------------------------------------------------------------
    # Existence check
    # ------------------------------------------------------------------------

    try:
        exists = folder.exists()

    except PermissionError as error:
        raise PermissionError("Permission denied while accessing the selected folder.") from error

    except OSError as error:
        raise OSError(f"Could not inspect the selected folder: {error}") from error

    if not exists:
        raise FileNotFoundError(f"The selected folder does not exist: {folder}")

    # ------------------------------------------------------------------------
    # Directory check
    # ------------------------------------------------------------------------

    try:
        is_directory = folder.is_dir()

    except PermissionError as error:
        raise PermissionError("Permission denied while accessing the selected folder.") from error

    except OSError as error:
        raise OSError(f"Could not inspect the selected folder: {error}") from error

    if not is_directory:
        raise NotADirectoryError(f"The selected path is not a folder: {folder}")

    # ------------------------------------------------------------------------
    # Verify that the directory can actually be read.
    # ------------------------------------------------------------------------

    try:
        iterator = folder.iterdir()
        next(iterator, None)

    except PermissionError as error:
        raise PermissionError("Permission denied while reading the selected folder.") from error

    except OSError as error:
        raise OSError(f"Could not read the selected folder: {error}") from error

    return folder


# ============================================================================
# FOLDER SCANNING
# ============================================================================


def get_files(folder: PathLike) -> list[Path]:
    """
    Return regular files directly inside the selected folder.

    Behavior:
        - Non-recursive.
        - Subdirectories are ignored.
        - Symbolic links are ignored.
        - Broken links are ignored.
        - Inaccessible/disappearing entries are skipped.
        - Results are sorted case-insensitively by filename.

    Raises:
        FileNotFoundError:
            Folder does not exist.

        NotADirectoryError:
            Supplied path is not a directory.

        PermissionError:
            Folder cannot be read.

        OSError:
            Other filesystem failure while reading the folder.
    """
    folder = _validate_folder(folder)

    files: list[Path] = []

    try:
        entries = list(folder.iterdir())

    except PermissionError as error:
        raise PermissionError("Permission denied while reading the selected folder.") from error

    except OSError as error:
        raise OSError(f"Could not read the selected folder: {error}") from error

    for item in entries:
        # Never follow symbolic links and only process regular files.
        if not _is_safe_regular_file(item):
            continue

        files.append(item)

    # Stable ordering makes GUI previews, tests, and operation history
    # deterministic.
    files.sort(
        key=lambda path: (
            path.name.casefold(),
            path.name,
        )
    )

    return files


# ============================================================================
# UNIQUE FILENAME GENERATION
# ============================================================================


def get_unique_path(folder: PathLike, filename: PathLike) -> Path:
    """
    Return a collision-free path inside ``folder``.

    The original filename is never returned.

    Filename suffix handling intentionally follows ``pathlib.Path``:

        photo.jpg
            -> photo_1.jpg

        README
            -> README_1

        backup.tar.gz
            -> backup.tar_1.gz

    This keeps filename generation compatible with normal ``Path.stem``
    and ``Path.suffix`` semantics.
    """
    folder = _normalize_path(folder)
    original = _normalize_path(filename)

    counter = 1

    while True:
        new_name = f"{original.stem}_{counter}{original.suffix}"

        candidate = folder / new_name

        try:
            if not _path_exists(candidate):
                return candidate

        except OSError as error:
            raise OSError(f"Could not check destination path: {candidate}") from error

        counter += 1


# ============================================================================
# SAFE DESTINATION PATH
# ============================================================================


def _get_destination_path(
    destination: PathLike,
    filename: PathLike,
) -> Path:
    """
    Return the safest available destination path for a filename.

    The original filename is preserved whenever possible.

    If a collision exists, a unique filename is generated.

    No filesystem entry is overwritten by this function.
    """
    destination = _normalize_path(destination)
    filename = _normalize_path(filename)

    target = destination / filename.name

    if not _path_exists(target):
        return target

    return get_unique_path(
        destination,
        filename.name,
    )


# ============================================================================
# MOVE HELPER
# ============================================================================


def _move_file(
    source: Path,
    destination: Path,
) -> None:
    """
    Move one safe regular file to a destination without overwriting it.

    The destination is checked immediately before the move. The actual
    move uses os.rename() rather than shutil.move(), because rename()
    provides the required non-overwriting behavior when source and
    destination are on the same filesystem.

    Raises:
        FileNotFoundError:
            Source disappeared or is no longer a safe regular file.

        FileExistsError:
            Destination already exists.

        OSError:
            Underlying filesystem operation failed.
    """
    if not _is_safe_regular_file(source):
        raise FileNotFoundError(
            f"Source file is no longer available: {source}"
        )

    if _path_exists(destination):
        raise FileExistsError(
            f"Destination already exists: {destination}"
        )

    try:
        source.rename(destination)

    except FileExistsError:
        # The destination appeared between the existence check and rename.
        raise FileExistsError(
            f"Destination already exists: {destination}"
        ) from None

    except OSError:
        raise


# ============================================================================
# ORGANIZATION
# ============================================================================


def organize_folder(folder: PathLike) -> list[MoveRecord]:
    """
    Organize files in a folder into category subdirectories.

    Only files directly inside ``folder`` are processed.

    Returns:
        list[MoveRecord]:
            Information about every successfully moved file.

    Each successful record contains:

        source
            Original file path.

        destination
            Final destination path.

        category
            Category assigned to the file.

    Behavior:
        - Original filenames are preserved whenever possible.
        - Collisions receive ``_1``, ``_2``, etc.
        - Existing files are never intentionally overwritten.
        - Symbolic links are ignored.
        - Subdirectories are not recursively processed.
        - Files disappearing during processing are skipped when possible.
        - A failure after successful moves triggers best-effort rollback.

    If rollback itself encounters an error, the original organization error
    is still re-raised.
    """
    folder = _validate_folder(folder)

    files = get_files(folder)

    if not files:
        return []

    moved_files: list[MoveRecord] = []

    try:
        for file_path in files:
            # The file may have disappeared or changed since the initial scan.
            if not _is_safe_regular_file(file_path):
                continue

            category = get_category(file_path)

            destination = _safe_category_directory(
                folder,
                category,
            )

            target = _get_destination_path(
                destination,
                file_path.name,
            )

            _move_file(
                file_path,
                target,
            )

            # Only record a move after the filesystem operation succeeds.
            moved_files.append(
                {
                    "source": file_path,
                    "destination": target,
                    "category": category,
                }
            )

    except (OSError, shutil.Error):
        # Restore every move completed before the failure.
        _rollback_moves(moved_files)

        # Preserve the original failure for the caller/GUI.
        raise

    return moved_files


# ============================================================================
# ROLLBACK
# ============================================================================


def _rollback_moves(
    moved_files: Iterable[Mapping[str, object]],
) -> None:
    """
    Best-effort rollback for a partially completed organization.

    A file is restored only when:
        - its destination still exists,
        - the destination is a safe regular file,
        - its original source does not exist,
        - the original source is not a symbolic link.

    Existing source files are never overwritten.

    Rollback failures are deliberately ignored so the original organization
    failure can be re-raised unchanged.
    """
    operations = list(moved_files)

    for item in reversed(operations):
        paths = _record_paths(item)

        if paths is None:
            continue

        source, destination = paths

        # --------------------------------------------------------------------
        # Destination must still contain a real organizer-created file.
        # --------------------------------------------------------------------

        if not _is_safe_destination_file(destination):
            continue

        # --------------------------------------------------------------------
        # Never overwrite an existing source entry.
        # --------------------------------------------------------------------

        if _path_exists(source):
            continue

        # --------------------------------------------------------------------
        # Never restore through a symbolic-link source path.
        # --------------------------------------------------------------------

        try:
            if source.is_symlink():
                continue
        except OSError:
            continue

        # --------------------------------------------------------------------
        # Attempt restoration.
        # --------------------------------------------------------------------

        try:
            source.parent.mkdir(
                parents=True,
                exist_ok=True,
            )

            # Re-check immediately before moving.
            if _path_exists(source):
                continue

            if source.is_symlink():
                continue

            shutil.move(
                str(destination),
                str(source),
            )

        except (OSError, shutil.Error):
            # Never hide the original organization failure.
            continue


# ============================================================================
# UNDO
# ============================================================================


def undo_organization(
    moved_files: Iterable[Mapping[str, object]] | None,
) -> list[MoveRecord]:
    """
    Restore files from a completed organization operation.

    Files are processed in reverse order.

    Safety rules:
        - Existing original locations are never overwritten.
        - Missing destination files are skipped.
        - Symbolic-link source paths are rejected.
        - Symbolic-link destination entries are rejected.
        - Invalid history records are skipped.
        - Failure to restore one file does not stop remaining files.

    Returns:
        list[MoveRecord]:
            Information about every successfully restored file.

    Each restored record contains:

        source
            Previous organized location.

        destination
            Original location.
    """
    if not moved_files:
        return []

    restored_files: list[MoveRecord] = []

    # Convert generators/iterators to a stable list before reversing.
    operations = list(moved_files)

    for item in reversed(operations):
        if not isinstance(item, Mapping):
            continue

        paths = _record_paths(item)

        if paths is None:
            continue

        source, destination = paths

        # --------------------------------------------------------------------
        # The organized file must still exist as a safe regular file.
        # --------------------------------------------------------------------

        if not _is_safe_destination_file(destination):
            continue

        # --------------------------------------------------------------------
        # Never overwrite an existing original file or filesystem entry.
        # --------------------------------------------------------------------

        if _path_exists(source):
            continue

        # --------------------------------------------------------------------
        # Never restore through a symbolic-link source path.
        # --------------------------------------------------------------------

        try:
            if source.is_symlink():
                continue
        except OSError:
            continue

        # --------------------------------------------------------------------
        # Attempt restoration.
        # --------------------------------------------------------------------

        try:
            source.parent.mkdir(
                parents=True,
                exist_ok=True,
            )

            # Re-check immediately before moving.
            if _path_exists(source):
                continue

            if source.is_symlink():
                continue

            shutil.move(
                str(destination),
                str(source),
            )

            restored_files.append(
                {
                    "source": destination,
                    "destination": source,
                }
            )

        except (OSError, shutil.Error):
            # Continue restoring remaining files.
            continue

    return restored_files


# ============================================================================
# PUBLIC API
# ============================================================================

__all__ = [
    "FILE_CATEGORIES",
    "CATEGORY_ORDER",
    "COMPOUND_EXTENSIONS",
    "EXTENSION_TO_CATEGORY",
    "get_category",
    "get_files",
    "get_unique_path",
    "organize_folder",
    "undo_organization",
]
