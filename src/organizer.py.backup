"""
File Organizer - Core File Management Engine

This module contains the filesystem logic used by the graphical
File Organizer application.

Responsibilities:
    - Categorize files by extension.
    - Safely scan folders.
    - Generate collision-free destination filenames.
    - Organize files into category folders.
    - Roll back partially completed organization operations.
    - Undo completed organization operations.

Design goals:
    - Safe filesystem operations.
    - No accidental overwrites.
    - No recursive folder processing.
    - No following symbolic links.
    - Predictable results for testing and GUI presentation.
    - Clear, reusable public functions.
    - Strong input validation.
    - Deterministic behavior.
    - Graceful handling of filesystem races and disappearing files.

This module intentionally contains no GUI code.
"""

from __future__ import annotations

import shutil
from collections.abc import Iterable, Mapping
from pathlib import Path

# ============================================================================
# TYPE ALIASES
# ============================================================================

PathLike = str | Path

# Kept as Dict[str, object] for compatibility with the existing project,
# tests, GUI code, and operation-history structures.
MoveRecord = dict[str, object]


